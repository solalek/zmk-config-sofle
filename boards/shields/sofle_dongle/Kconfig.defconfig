if SHIELD_SOFLE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Sofle Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Для Sofle нужно 2 (левая и правая половинки)
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 2 половинки + 5 Bluetooth профилей = 7
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
